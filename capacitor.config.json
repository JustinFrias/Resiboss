{
  "appId": "com.resiboss.app",
  "appName": "Resiboss",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "resiboss.vercel.app",
      "*.pipedream.net",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  }
}
